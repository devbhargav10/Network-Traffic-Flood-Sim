# Generate a unique random secret (at least 32 characters); never commit .env.
SIM_API_KEY=replace-with-a-random-secret-at-least-32-characters
# Comma-separated private lab IPs/CIDRs. Empty means deny all targets.
SIM_ALLOWED_TARGETS=192.168.100.20/32
SIM_DB_PATH=/app/data/simulator.db

SIM_WLAN_AGENT_ENABLED=false
