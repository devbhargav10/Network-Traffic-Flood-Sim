# Copy to .env and replace the API key with a unique random secret.
# PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SIM_API_KEY=replace-with-a-random-secret-at-least-32-characters
# Comma-separated private lab IPs/CIDRs; keep empty until lab target is confirmed.
SIM_ALLOWED_TARGETS=
