# Copy to .env and replace with a unique random API key (at least 32 characters).
SIM_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Local-only test execution. Set true only when you intend to run the loopback test.
SIM_LOCAL_TRAFFIC_ENABLED=false

# Enable queued Windows WLAN host-agent execution only after receiver setup
SIM_WLAN_AGENT_ENABLED=false
